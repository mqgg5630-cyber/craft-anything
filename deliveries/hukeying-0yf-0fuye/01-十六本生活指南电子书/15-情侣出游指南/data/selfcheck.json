{
  "version": "1.0.0",
  "title": "出游自查",
  "intro": "24 道是否题，六个维度。检查的是一次出门的协作：你怎么约、怎么排、怎么拍、怎么发、怎么吃，以及边界有没有守住。第 15、22、23 题是红线题，任何一题答「否」，都会先给出对应提醒。",
  "scale": {
    "yes": 2,
    "unsure": 1,
    "no": 0
  },
  "dimensions": [
    {
      "id": "plan",
      "name": "约与定",
      "desc": "邀请、方案、预算，给的是选择题吗。"
    },
    {
      "id": "pace",
      "name": "行程",
      "desc": "节奏、留白、体力与备选，算过吗。"
    },
    {
      "id": "photo",
      "name": "拍照",
      "desc": "问偏好、构图、光线、连拍、沟通。"
    },
    {
      "id": "record",
      "name": "记录与发布",
      "desc": "当场审片、发之前问、相册边界。"
    },
    {
      "id": "eat",
      "name": "吃饭",
      "desc": "选店、排队、点菜、踩雷补救、买单。"
    },
    {
      "id": "safe",
      "name": "应变与边界",
      "desc": "下雨、生理期、走散、同意与安全机位。"
    }
  ],
  "questions": [
    {
      "id": "q1",
      "dim": "plan",
      "text": "我约会时给的是两个带起止时间的选项，而不是「你什么时候有空」。",
      "read": "1.1",
      "hint": "开放提问把活丢给对方。"
    },
    {
      "id": "q2",
      "dim": "plan",
      "text": "我会按一天、周末、长假给不同密度的行程。",
      "read": "1.2",
      "hint": "三档玩法不同。"
    },
    {
      "id": "q3",
      "dim": "plan",
      "text": "我说得清这次的预算区间和谁来付哪一项。",
      "read": "1.4",
      "hint": "钱说清才不别扭。"
    },
    {
      "id": "q4",
      "dim": "plan",
      "text": "她说「随便」时，我会追问一个具体维度（辣度、距离、预算）。",
      "read": "1.6",
      "hint": "模糊要一次具体化。"
    },
    {
      "id": "q5",
      "dim": "pace",
      "text": "我的一天行程里有至少两小时什么都不安排。",
      "read": "2.4",
      "hint": "留白是保险。"
    },
    {
      "id": "q6",
      "dim": "pace",
      "text": "出发前我算过步行总距离、厕所位置和能坐下的地方。",
      "read": "2.5",
      "hint": "体力影响脾气。"
    },
    {
      "id": "q7",
      "dim": "pace",
      "text": "我为每个主计划准备了一个十分钟内能到的备选。",
      "read": "2.6",
      "hint": "变故只改路线。"
    },
    {
      "id": "q8",
      "dim": "pace",
      "text": "排队超过一小时的点，我会提议换，而不是硬扛。",
      "read": "2.2",
      "hint": "排队性价比常为负。"
    },
    {
      "id": "q9",
      "dim": "photo",
      "text": "拍照前我会先问她要拍成什么样，并试三张定方向。",
      "read": "3.1",
      "hint": "先对齐口味。"
    },
    {
      "id": "q10",
      "dim": "photo",
      "text": "我会调站位、机位和前景，而不是举起来就按。",
      "read": "3.2",
      "hint": "三招救九成照片。"
    },
    {
      "id": "q11",
      "dim": "photo",
      "text": "我会用连拍和聊天抓自然表情，不喊「一二三笑」。",
      "read": "3.4",
      "hint": "好看的是第 8 张。"
    },
    {
      "id": "q12",
      "dim": "photo",
      "text": "她说「我好丑」时，我先否定那个判断，再重拍。",
      "read": "3.5",
      "hint": "她要的是重来。"
    },
    {
      "id": "q13",
      "dim": "record",
      "text": "我当天不边拍边审，照片留到晚上一起挑。",
      "read": "4.1",
      "hint": "当场审片像面试。"
    },
    {
      "id": "q14",
      "dim": "record",
      "text": "发合照前我会先问一句，得到同意再发。",
      "read": "4.4",
      "hint": "肖像是两个人的。"
    },
    {
      "id": "q15",
      "dim": "record",
      "text": "我不会把她的照片做成表情包或发到群里当玩笑。",
      "read": "4.5",
      "hint": "亲密关系不豁免。",
      "critical": true
    },
    {
      "id": "q16",
      "dim": "record",
      "text": "我们的共享相册说清了谁能看、谁能传、能不能外发。",
      "read": "4.6",
      "hint": "共享范围难收回。"
    },
    {
      "id": "q17",
      "dim": "eat",
      "text": "选店时我按距离、可预约、她能吃什么三项筛过。",
      "read": "5.1",
      "hint": "饿的时候不做决定。"
    },
    {
      "id": "q18",
      "dim": "eat",
      "text": "等位超过二十分钟，我会给出换店选项。",
      "read": "5.4",
      "hint": "等待要有掌控感。"
    },
    {
      "id": "q19",
      "dim": "eat",
      "text": "踩雷时我先止损，不在饭桌复盘是谁选错了店。",
      "read": "5.5",
      "hint": "止损比追责有用。"
    },
    {
      "id": "q20",
      "dim": "eat",
      "text": "买单规则我们提前说清，不临场抢单推让。",
      "read": "5.6",
      "hint": "规则确定省摩擦。"
    },
    {
      "id": "q21",
      "dim": "safe",
      "text": "她生理期或不舒服时，行程立刻作废，先解决身体。",
      "read": "6.2",
      "hint": "身体优先。"
    },
    {
      "id": "q22",
      "dim": "safe",
      "text": "住宿与亲密行为我都明确问过，并且接受「不」。",
      "read": "7.1",
      "hint": "没拒绝不等于同意。",
      "critical": true
    },
    {
      "id": "q23",
      "dim": "safe",
      "text": "我不为出片去悬崖、铁轨、涨水河床或车流里，也不在禁飞区飞无人机。",
      "read": "7.3",
      "hint": "照片不是必需品。",
      "critical": true
    },
    {
      "id": "q24",
      "dim": "safe",
      "text": "回来当天我们做了十分钟复盘：哪段最好、哪段最累、下次改一件。",
      "read": "7.6",
      "hint": "复盘省下一次吵。"
    }
  ]
}
